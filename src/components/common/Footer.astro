---
import { Icon } from 'astro-icon/components';

const socialLinks = [
  {
    title: 'LinkedIn',
    href: 'https://www.linkedin.com/company/northern-venture-drone-services',
    icon: 'mdi:linkedin',
  },
  {
    title: 'Instagram',
    href: 'https://www.instagram.com/northernventure',
    icon: 'mdi:instagram',
  },
  {
    title: 'Email',
    href: 'mailto:hello@northernventure.ca',
    icon: 'mdi:email-outline',
  },
];
---

<footer class="w-screen bg-[#E4572E] py-4 text-black">
  <div
    class="container mx-auto flex flex-col items-center justify-between gap-4 px-4 md:flex-row"
  >
    <p class="text-center text-sm font-light md:text-left">
      &copy; Northern Venture Drone Services {new Date().getFullYear()}. All
      rights reserved
    </p>

    <div class="flex justify-center gap-4 md:justify-end pr-4">
      {
        socialLinks.map((link, index) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-black transition-colors duration-500 ease-in-out hover:text-white"
          >
            <Icon name={link.icon} />
          </a>
        ))
      }
    </div>
  </div>
</footer>
